<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAF8"
    android:fillViewport="true"
    android:padding="16dp"
    tools:context=".ui.profile.EditProfileFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="32dp">

        <!-- HEADER CARD -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardEditHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            app:cardBackgroundColor="#386458"
            app:cardCornerRadius="24dp"
            app:cardElevation="0dp"
            app:contentPadding="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Edit Profil"
                    android:textColor="@android:color/white"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Perbarui informasi profil, keahlian, dan pengalaman Anda"
                    android:textColor="#EAF4F0"
                    android:textSize="14sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- AVATAR / PHOTO PICKER -->
        <FrameLayout
            android:id="@+id/flEditAvatarContainer"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="24dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackgroundBorderless">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/ivEditProfileAvatar"
                android:layout_width="92dp"
                android:layout_height="92dp"
                android:layout_gravity="center"
                android:background="#EAF4F0"
                android:scaleType="centerCrop"
                android:src="@android:drawable/ic_menu_gallery"
                app:cornerFamily="rounded"
                app:cornerSize="50%" />

            <!-- Badge ikon kamera -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_gravity="bottom|end"
                app:cardBackgroundColor="#386458"
                app:cardCornerRadius="15dp"
                app:cardElevation="3dp"
                app:strokeColor="@android:color/white"
                app:strokeWidth="2dp">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_gravity="center"
                    android:src="@android:drawable/ic_menu_camera"
                    app:tint="@android:color/white" />
            </com.google.android.material.card.MaterialCardView>
        </FrameLayout>

        <!-- NAMA LENGKAP -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilProfileName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            android:hint="Nama Lengkap"
            app:boxBackgroundColor="@android:color/white"
            app:boxCornerRadiusBottomEnd="14dp"
            app:boxCornerRadiusBottomStart="14dp"
            app:boxCornerRadiusTopEnd="14dp"
            app:boxCornerRadiusTopStart="14dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etProfileName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textPersonName"
                android:textColor="#191C1B" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- JOB TITLE / PERAN -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilProfileJob"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            android:hint="Pekerjaan / Peran (misal: Professional Caregiver)"
            app:boxBackgroundColor="@android:color/white"
            app:boxCornerRadiusBottomEnd="14dp"
            app:boxCornerRadiusBottomStart="14dp"
            app:boxCornerRadiusTopEnd="14dp"
            app:boxCornerRadiusTopStart="14dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etProfileJob"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textCapWords"
                android:textColor="#191C1B" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- UMUR -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilProfileAge"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            android:hint="Umur (dalam tahun)"
            app:boxBackgroundColor="@android:color/white"
            app:boxCornerRadiusBottomEnd="14dp"
            app:boxCornerRadiusBottomStart="14dp"
            app:boxCornerRadiusTopEnd="14dp"
            app:boxCornerRadiusTopStart="14dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etProfileAge"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number"
                android:textColor="#191C1B" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- ABOUT ME / BIO -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilProfileBio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            android:hint="About Me / Tentang Saya"
            app:boxBackgroundColor="@android:color/white"
            app:boxCornerRadiusBottomEnd="14dp"
            app:boxCornerRadiusBottomStart="14dp"
            app:boxCornerRadiusTopEnd="14dp"
            app:boxCornerRadiusTopStart="14dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etProfileBio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textMultiLine"
                android:minLines="3"
                android:gravity="top"
                android:textColor="#191C1B" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- EXPERIENCE -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilProfileExp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            android:hint="Pengalaman Kerja (pisahkan dengan baris baru / Enter)"
            app:boxBackgroundColor="@android:color/white"
            app:boxCornerRadiusBottomEnd="14dp"
            app:boxCornerRadiusBottomStart="14dp"
            app:boxCornerRadiusTopEnd="14dp"
            app:boxCornerRadiusTopStart="14dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etProfileExp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textMultiLine"
                android:minLines="3"
                android:gravity="top"
                android:textColor="#191C1B" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- SKILLS -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilProfileSkills"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:hint="Keahlian / Skills (pisahkan dengan koma)"
            app:boxBackgroundColor="@android:color/white"
            app:boxCornerRadiusBottomEnd="14dp"
            app:boxCornerRadiusBottomStart="14dp"
            app:boxCornerRadiusTopEnd="14dp"
            app:boxCornerRadiusTopStart="14dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etProfileSkills"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textMultiLine"
                android:minLines="2"
                android:gravity="top"
                android:textColor="#191C1B" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- TOMBOL SIMPAN -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSaveProfile"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Simpan Perubahan"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            app:backgroundTint="#386458"
            app:cornerRadius="14dp" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>

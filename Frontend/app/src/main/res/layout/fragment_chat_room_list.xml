<?xml version='1.0' encoding='utf-8'?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#FAFAFA" android:padding="16dp">

    <TextView android:id="@+id/tvTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/txt_fragment_chat_room_list_100" android:textSize="24sp" android:textStyle="bold" android:textColor="#333333" app:layout_constraintTop_toTopOf="parent" app:layout_constraintStart_toStartOf="parent" />

    
    
    <FrameLayout android:id="@+id/flFamilyChatWrapper" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" app:layout_constraintTop_toBottomOf="@id/tvTitle">

        <androidx.cardview.widget.CardView android:id="@+id/cvFamilyChat" android:layout_width="match_parent" android:layout_height="wrap_content" app:cardCornerRadius="12dp" app:cardElevation="2dp" app:cardBackgroundColor="#FFFFFF" android:foreground="?android:attr/selectableItemBackground" android:clickable="true" android:focusable="true">

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:padding="16dp">

                <ImageView android:layout_width="48dp" android:layout_height="48dp" android:src="@drawable/ic_chat" app:tint="#1976D2" android:contentDescription="@null" />

                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="16dp">

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/txt_fragment_chat_room_list_101" android:textStyle="bold" android:textSize="18sp" android:textColor="#212121" />

                    
                    <TextView android:id="@+id/tvLastMessage" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/txt_fragment_chat_room_list_102" android:textSize="14sp" android:textColor="#757575" />

                </LinearLayout>

                
                <TextView android:id="@+id/tvUnreadBadge" android:layout_width="24dp" android:layout_height="24dp" android:gravity="center" android:textColor="@android:color/white" android:textSize="11sp" android:textStyle="bold" android:background="@drawable/bg_unread_badge" android:visibility="gone" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </FrameLayout>

    
    <androidx.cardview.widget.CardView android:id="@+id/cvAiChat" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" app:cardCornerRadius="12dp" app:cardElevation="2dp" app:cardBackgroundColor="#FFFFFF" android:foreground="?android:attr/selectableItemBackground" android:clickable="true" android:focusable="true" app:layout_constraintTop_toBottomOf="@id/flFamilyChatWrapper">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:padding="16dp">

            <ImageView android:layout_width="48dp" android:layout_height="48dp" android:src="@android:drawable/ic_menu_compass" app:tint="#388E3C" android:contentDescription="@null" />

            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="16dp">

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/txt_fragment_chat_room_list_103" android:textStyle="bold" android:textSize="18sp" android:textColor="#212121" />

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/txt_fragment_chat_room_list_104" android:textSize="14sp" android:textColor="#757575" />
            </LinearLayout>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>
<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:id="@+id/adminUsers"
    android:background="#F9FAFB">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/nestedScrollView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingBottom="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp">

            <ImageView
                android:id="@+id/btnBack"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_arrow_back"
                app:tint="#2D4A43"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent" />

            <TextView
                android:id="@+id/tvAppTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CareMate Users"
                android:textColor="#2D4A43"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginStart="16dp"
                app:layout_constraintTop_toTopOf="@id/btnBack"
                app:layout_constraintBottom_toBottomOf="@id/btnBack"
                app:layout_constraintStart_toEndOf="@id/btnBack" />

            <TextView
                android:id="@+id/tvPageTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="User Management"
                android:textColor="#0B253A"
                android:textSize="24sp"
                android:textStyle="bold"
                android:layout_marginTop="24dp"
                app:layout_constraintTop_toBottomOf="@id/btnBack"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />


            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardTotalUsers"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginEnd="8dp"
                app:cardBackgroundColor="@android:color/white"
                app:cardCornerRadius="12dp"
                app:strokeWidth="0dp"
                app:layout_constraintTop_toBottomOf="@id/tvPageTitle"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/cardCaregivers"
                app:layout_constraintHorizontal_chainStyle="spread">
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp">
                    <TextView android:id="@+id/lblTotal" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Total Users" android:textColor="#5A6E72" android:textSize="12sp" app:layout_constraintTop_toTopOf="parent" app:layout_constraintStart_toStartOf="parent"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="124" android:textColor="#0B253A" android:textSize="20sp" android:textStyle="bold" android:layout_marginTop="4dp" app:layout_constraintTop_toBottomOf="@id/lblTotal" app:layout_constraintStart_toStartOf="parent"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardCaregivers"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                app:cardBackgroundColor="@android:color/white"
                app:cardCornerRadius="12dp"
                app:strokeWidth="0dp"
                app:layout_constraintTop_toTopOf="@id/cardTotalUsers"
                app:layout_constraintStart_toEndOf="@id/cardTotalUsers"
                app:layout_constraintEnd_toEndOf="parent">
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp">
                    <TextView android:id="@+id/lblCare" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Caregivers" android:textColor="#5A6E72" android:textSize="12sp" app:layout_constraintTop_toTopOf="parent" app:layout_constraintStart_toStartOf="parent"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="42" android:textColor="#0B253A" android:textSize="20sp" android:textStyle="bold" android:layout_marginTop="4dp" app:layout_constraintTop_toBottomOf="@id/lblCare" app:layout_constraintStart_toStartOf="parent"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardFamily"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_marginEnd="8dp"
                app:cardBackgroundColor="@android:color/white"
                app:cardCornerRadius="12dp"
                app:strokeWidth="0dp"
                app:layout_constraintTop_toBottomOf="@id/cardTotalUsers"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/cardActiveNow"
                app:layout_constraintHorizontal_chainStyle="spread">
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp">
                    <TextView android:id="@+id/lblFam" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Family" android:textColor="#5A6E72" android:textSize="12sp" app:layout_constraintTop_toTopOf="parent" app:layout_constraintStart_toStartOf="parent"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="78" android:textColor="#0B253A" android:textSize="20sp" android:textStyle="bold" android:layout_marginTop="4dp" app:layout_constraintTop_toBottomOf="@id/lblFam" app:layout_constraintStart_toStartOf="parent"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardActiveNow"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                app:cardBackgroundColor="@android:color/white"
                app:cardCornerRadius="12dp"
                app:strokeWidth="0dp"
                app:layout_constraintTop_toTopOf="@id/cardFamily"
                app:layout_constraintStart_toEndOf="@id/cardFamily"
                app:layout_constraintEnd_toEndOf="parent">
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp">
                    <TextView android:id="@+id/lblActive" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Active Now" android:textColor="#5A6E72" android:textSize="12sp" app:layout_constraintTop_toTopOf="parent" app:layout_constraintStart_toStartOf="parent"/>
                    <View android:id="@+id/dotActive" android:layout_width="8dp" android:layout_height="8dp" android:background="@android:color/holo_green_light" android:backgroundTint="#4CAF50" android:layout_marginTop="12dp" app:layout_constraintTop_toBottomOf="@id/lblActive" app:layout_constraintStart_toStartOf="parent" app:layout_constraintBottom_toBottomOf="parent"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="18" android:textColor="#0B253A" android:textSize="20sp" android:textStyle="bold" android:layout_marginStart="6dp" app:layout_constraintTop_toTopOf="@id/dotActive" app:layout_constraintBottom_toBottomOf="@id/dotActive" app:layout_constraintStart_toEndOf="@id/dotActive"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

            <EditText
                android:id="@+id/etSearch"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_search_input"
                android:hint="Search by name or email..."
                android:textColorHint="#9CA3AF"
                android:textSize="14sp"
                android:paddingStart="40dp"
                android:paddingEnd="16dp"
                android:inputType="text"
                android:importantForAutofill="no"
                app:layout_constraintTop_toBottomOf="@id/cardFamily"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginStart="14dp"
                android:src="@drawable/ic_arrow_back"
                app:tint="#9CA3AF"
                app:layout_constraintTop_toTopOf="@id/etSearch"
                app:layout_constraintBottom_toBottomOf="@id/etSearch"
                app:layout_constraintStart_toStartOf="@id/etSearch"/>


            <HorizontalScrollView
                android:id="@+id/tabScroll"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:scrollbars="none"
                app:layout_constraintTop_toBottomOf="@+id/etSearch"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/chipAll"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:text="All Users"
                        android:textColor="@android:color/white"
                        app:backgroundTint="#2D4A43"
                        app:cornerRadius="18dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toStartOf="parent"/>
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/chipCaregivers"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:text="Caregivers"
                        android:textColor="#4B5563"
                        app:backgroundTint="#E5E7EB"
                        app:cornerRadius="18dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:layout_marginStart="8dp"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toEndOf="@id/chipAll"/>
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/chipFamily"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:text="Family Members"
                        android:textColor="#4B5563"
                        app:backgroundTint="#E5E7EB"
                        app:cornerRadius="18dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:layout_marginStart="8dp"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toEndOf="@id/chipCaregivers"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/chipInactive"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:text="Inactive Users"
                        android:textColor="#4B5563"
                        app:backgroundTint="#E5E7EB"
                        app:cornerRadius="18dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:layout_marginStart="8dp"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toEndOf="@id/chipFamily"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </HorizontalScrollView>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvUserList"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:nestedScrollingEnabled="false"
                app:layout_constraintTop_toBottomOf="@id/tabScroll"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                tools:listitem="@layout/item_user" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabAddUser"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        android:src="@drawable/ic_plus"
        app:backgroundTint="#2D4A43"
        app:fabSize="normal"
        app:tint="@android:color/white"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
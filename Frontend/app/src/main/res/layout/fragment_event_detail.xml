<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/caremate_tertiary"
    tools:context=".ui.community.EventDetailFragment">

    <!-- Header Card dengan info utama event -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardDetailHeader"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@color/caremate_secondary"
        app:cardCornerRadius="0dp"
        app:cardElevation="0dp"
        app:contentPadding="20dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Tombol back -->
            <Button
                android:id="@+id/btnDetailBack"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:drawableStart="@android:drawable/ic_media_previous"
                android:drawablePadding="4dp"
                android:text="@string/community_back"
                android:textColor="@android:color/white" />

            <!-- Judul event -->
            <TextView
                android:id="@+id/tvDetailTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@android:color/white"
                android:textSize="22sp"
                android:textStyle="bold"
                tools:text="Seminar Kesehatan Lansia 2025" />

            <!-- Tanggal -->
            <TextView
                android:id="@+id/tvDetailDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_time_chip"
                android:paddingHorizontal="12dp"
                android:paddingVertical="4dp"
                android:textColor="@color/caremate_secondary"
                android:textSize="13sp"
                android:textStyle="bold"
                tools:text="20 Juni 2025" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- ScrollView untuk konten detail -->
    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/cardDetailHeader">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Card Lokasi -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardDetailLocation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:contentPadding="16dp"
                app:strokeColor="@color/caremate_outline"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/community_detail_location_label"
                        android:textColor="@color/caremate_muted"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tvDetailLocation"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textColor="@color/caremate_neutral"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        tools:text="Gedung Serbaguna, Jakarta" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Card Penyelenggara -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardDetailOrganizer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:contentPadding="16dp"
                app:strokeColor="@color/caremate_outline"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/community_detail_organizer_label"
                        android:textColor="@color/caremate_muted"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tvDetailOrganizer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textColor="@color/caremate_neutral"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        tools:text="Yayasan Peduli Lansia" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Card Deskripsi -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardDetailDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:contentPadding="16dp"
                app:strokeColor="@color/caremate_outline"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/community_detail_description_label"
                        android:textColor="@color/caremate_muted"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tvDetailDescription"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:lineSpacingExtra="4dp"
                        android:textColor="@color/caremate_neutral"
                        android:textSize="14sp"
                        tools:text="Seminar ini membahas cara merawat lansia dengan baik, strategi manajemen obat, dan pentingnya dukungan keluarga dalam proses perawatan." />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>

<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp" android:background="@drawable/rounded_bottom_sheet">

    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/txt_bottom_sheet_medical_profile_54" android:textSize="20sp" android:textStyle="bold" android:textColor="@color/black" android:layout_marginBottom="8dp" />

    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/txt_bottom_sheet_medical_profile_55" android:textSize="14sp" android:layout_marginBottom="24dp" />

    <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/txt_bottom_sheet_medical_profile_56" style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox" android:layout_marginBottom="16dp">
        
        <com.google.android.material.textfield.TextInputEditText android:id="@+id/etDiagnosis" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="text" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/txt_bottom_sheet_medical_profile_57" style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox" android:layout_marginBottom="16dp">
        
        <com.google.android.material.textfield.TextInputEditText android:id="@+id/etAllergies" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="text" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/txt_bottom_sheet_medical_profile_58" style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox" android:layout_marginBottom="16dp">
        
        <com.google.android.material.textfield.TextInputEditText android:id="@+id/etTexture" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="text" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/txt_bottom_sheet_medical_profile_59" style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox" android:layout_marginBottom="24dp">
        
        <com.google.android.material.textfield.TextInputEditText android:id="@+id/etPreferences" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="text" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.button.MaterialButton android:id="@+id/btnSaveProfile" android:layout_width="match_parent" android:layout_height="60dp" android:text="@string/txt_bottom_sheet_medical_profile_60" android:textSize="16sp" android:textStyle="bold" android:layout_marginBottom="16dp" />

</LinearLayout>
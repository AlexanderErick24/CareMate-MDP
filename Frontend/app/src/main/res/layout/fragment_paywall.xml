<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="24dp"
    android:background="#FAFAFA"
    tools:context=".ui.premium.PaywallFragment">

    <ImageView
        android:id="@+id/ivPremiumIcon"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:src="@android:drawable/btn_star_big_on"
        app:tint="#FFC107"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="32dp"/>

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="CareMate Premium"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="#333333"
        app:layout_constraintTop_toBottomOf="@id/ivPremiumIcon"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="16dp"/>

    <TextView
        android:id="@+id/tvSubtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Buka semua fitur cerdas AI untuk merawat keluarga Anda dengan lebih baik."
        android:textSize="16sp"
        android:textAlignment="center"
        android:textColor="#666666"
        app:layout_constraintTop_toBottomOf="@id/tvTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="8dp"/>

    <!-- Fitur List -->
    <LinearLayout
        android:id="@+id/llFeatures"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintTop_toBottomOf="@id/tvSubtitle"
        android:layout_marginTop="32dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="✓ AI Vision Anomaly Detection"
            android:textSize="16sp"
            android:layout_marginBottom="12dp"
            android:textColor="#333333" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="✓ Smart AI Nutrition"
            android:textSize="16sp"
            android:layout_marginBottom="12dp"
            android:textColor="#333333" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="✓ AI Mindful Journaling"
            android:textSize="16sp"
            android:layout_marginBottom="12dp"
            android:textColor="#333333" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="✓ Tambah Anggota Keluarga Tak Terbatas"
            android:textSize="16sp"
            android:layout_marginBottom="12dp"
            android:textColor="#333333" />
    </LinearLayout>

    <Button
        android:id="@+id/btnBuyPremium"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="Berlangganan Rp 50.000 / Bulan"
        android:textSize="16sp"
        android:textStyle="bold"
        android:backgroundTint="#4CAF50"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="24dp"/>

    <!-- Simulasi Browser WebView -->
    <WebView
        android:id="@+id/webViewMidtrans"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/btnBypassPremium"/>

    <!-- Tombol bypass muncul di bawah WebView saat halaman pembayaran terbuka -->
    <Button
        android:id="@+id/btnBypassPremium"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="⚡ Simulasi: Langsung Aktifkan Premium"
        android:textSize="14sp"
        android:textStyle="bold"
        android:backgroundTint="#FF9800"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>

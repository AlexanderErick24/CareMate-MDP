# CareMate Backend Environment Variables Template
# Copy this file to .env and configure with your keys for local development
# Configure these variables in the Render dashboard for production deployment

# Server Port (Render will inject this automatically, defaults to 3000 locally)
PORT=3000

# Google Gemini API key
GEMINI_API_KEY=your_gemini_api_key_here

# Midtrans Client and Server Keys (Sandbox for testing, Production for release)
MIDTRANS_SERVER_KEY=SB-Mid-server-your_server_key_here
MIDTRANS_CLIENT_KEY=SB-Mid-client-your_client_key_here

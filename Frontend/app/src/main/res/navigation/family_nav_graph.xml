<?xml version="1.0" encoding="utf-8"?>

<navigation
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"

    android:id="@+id/family_nav_graph"

    app:startDestination="@id/familyDashboardFragment">

    <fragment
        android:id="@+id/registerFragment"
        android:name="com.mdp.caremate.ui.auth.RegisterFragment">

        <argument
            android:name="isFromFamily"
            app:argType="boolean"
            android:defaultValue="false"/>

        <argument
            android:name="pairingCode"
            app:argType="string"
            android:defaultValue=""/>

    </fragment>

    <fragment
        android:id="@+id/familyDashboardFragment"
        android:name="com.mdp.caremate.ui.family.dashboard.FamilyDashboardFragment">

        <action
            android:id="@+id/action_family_dashboard_to_chat"
            app:destination="@id/chatFragment"/>
            
        <action
            android:id="@+id/action_family_dashboard_to_ai_alert_history"
            app:destination="@id/aiAlertHistoryFragment"/>
    </fragment>

    <fragment
        android:id="@+id/chatFragment"
        android:name="com.mdp.caremate.ui.chat.ChatRoomListFragment">
        <action
            android:id="@+id/action_chatRoomList_to_familyChat"
            app:destination="@id/familyChatFragment"/>
        <action
            android:id="@+id/action_chatRoomList_to_aiChat"
            app:destination="@id/aiChatFragment"/>
    </fragment>

    <fragment
        android:id="@+id/familyChatFragment"
        android:name="com.mdp.caremate.ui.chat.ChatFragment"/>

    <fragment
        android:id="@+id/aiChatFragment"
        android:name="com.mdp.caremate.ui.chat.JournalingChatFragment"/>
    <fragment
        android:id="@+id/familyManagementFragment"
        android:name="com.mdp.caremate.ui.family.management.FamilyManagementFragment">

        <action
            android:id="@+id/action_family_management_to_register"
            app:destination="@id/registerFragment"/>
    </fragment>

    <fragment
        android:id="@+id/familyProfileFragment"
        android:name="com.mdp.caremate.ui.family.profile.FamilyProfileFragment"/>

    <fragment
        android:id="@+id/aiAlertHistoryFragment"
        android:name="com.mdp.caremate.ui.family.alert.AiAlertHistoryFragment"
        android:label="AI Alert History"/>

</navigation>
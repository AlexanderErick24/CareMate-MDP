<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/loginFragment">

    <fragment
        android:id="@+id/loginFragment"
        android:name="com.mdp.caremate.ui.auth.LoginFragment"
        android:label="Login">

        <action
            android:id="@+id/action_login_to_register"
            app:destination="@id/registerFragment"/>

        <action
            android:id="@+id/action_login_to_dashboard"
            app:destination="@id/dest_dashboard"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true"/>
        <action
            android:id="@+id/action_loginFragment_to_adminCommunityDashboardFragment"
            app:destination="@id/adminCommunityDashboardFragment" />


    </fragment>

    <fragment
        android:id="@+id/registerFragment"
        android:name="com.mdp.caremate.ui.auth.RegisterFragment"
        android:label="Register">

        <action
            android:id="@+id/action_register_to_login"
            app:destination="@id/loginFragment"/>

    </fragment>

    <fragment
        android:id="@+id/dest_dashboard"
        android:name="com.mdp.caremate.ui.dashboard.DashboardFragment"
        android:label="Dashboard"
        tools:layout="@layout/fragment_dashboard">
        <action
            android:id="@+id/action_dest_dashboard_to_dest_med_form"
            app:destination="@id/dest_med_form" />
    </fragment>

    <fragment
        android:id="@+id/dest_med_form"
        android:name="com.mdp.caremate.ui.medicationform.MedFormFragment"
        android:label="Medication Form"
        tools:layout="@layout/fragment_med_form" />

    <fragment
        android:id="@+id/dest_community"
        android:name="com.mdp.caremate.ui.community.CommunityFragment"
        android:label="Komunitas"
        tools:layout="@layout/fragment_community">
        <action
            android:id="@+id/action_dest_community_to_dest_event_detail"
            app:destination="@id/dest_event_detail" />
    </fragment>

    <fragment
        android:id="@+id/dest_event_detail"
        android:name="com.mdp.caremate.ui.community.EventDetailFragment"
        android:label="Detail Event"
        tools:layout="@layout/fragment_event_detail" />

    <fragment
        android:id="@+id/dest_premium"
        android:name="com.mdp.caremate.ui.premium.JournalingFragment"
        android:label="Premium Services"
        tools:layout="@layout/fragment_journaling" />

    <fragment
        android:id="@+id/dest_profile"
        android:name="com.mdp.caremate.ui.profile.ProfileFragment"
        android:label="Profile"
        tools:layout="@layout/fragment_profile" />

<!--    <fragment-->
<!--        android:id="@+id/dest_admin"-->
<!--        android:name="com.mdp.caremate.ui.admin.AdminFragment"-->
<!--        android:label="Admin Panel"-->
<!--        tools:layout="@layout/fragment_admin" />-->

    <!-- FAMILY -->
    <fragment
        android:id="@+id/familyContainerFragment"
        android:name="com.mdp.caremate.ui.family.FamilyContainerFragment"
        android:label="Family Container"
        tools:layout="@layout/fragment_family_container">

        <action
            android:id="@+id/action_family_container_to_login"
            app:destination="@id/loginFragment"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="false" />
    </fragment>
    <fragment
        android:id="@+id/adminCommunityDashboardFragment"
        android:name="com.mdp.caremate.ui.admin.AdminCommunityDashboardFragment"
        android:label="AdminCommunityDashboardFragment" />

    <!-- CHAT -->
    <fragment
        android:id="@+id/chatFragment"
        android:name="com.mdp.caremate.ui.chat.ChatFragment"
        android:label="Chat Message"
        tools:layout="@layout/fragment_chat"/>


</navigation>
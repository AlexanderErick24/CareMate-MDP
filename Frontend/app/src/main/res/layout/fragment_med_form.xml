<?xml version='1.0' encoding='utf-8'?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:tools="http://schemas.android.com/tools" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/caremate_tertiary" android:fillViewport="true" android:padding="16dp" tools:context=".ui.medicationform.MedFormFragment">

    <androidx.constraintlayout.widget.ConstraintLayout android:layout_width="match_parent" android:layout_height="wrap_content">

        <com.google.android.material.card.MaterialCardView android:id="@+id/cardMedFormContainer" android:layout_width="match_parent" android:layout_height="wrap_content" app:cardBackgroundColor="@color/white" app:cardCornerRadius="32dp" app:cardElevation="8dp" app:contentPadding="24dp" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent">

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">

                
                <TextView android:id="@+id/tvMedFormTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center_horizontal" android:layout_marginBottom="20dp" android:text="@string/med_form_title_add" android:textColor="@color/caremate_neutral" android:textSize="22sp" android:textStyle="bold" />

                
                <TextView android:id="@+id/tvMedFormSubtitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:visibility="gone" />

                
                <com.google.android.material.textfield.TextInputLayout android:id="@+id/tilMedName" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/txt_dialog_medication_preview_62" app:boxBackgroundColor="@android:color/transparent" app:boxCornerRadiusBottomEnd="20dp" app:boxCornerRadiusBottomStart="20dp" app:boxCornerRadiusTopEnd="20dp" app:boxCornerRadiusTopStart="20dp" app:boxStrokeColor="@color/caremate_primary" app:boxStrokeWidth="1.5dp" app:startIconDrawable="@drawable/ic_pill" app:startIconTint="@color/caremate_primary">

                    <com.google.android.material.textfield.TextInputEditText android:id="@+id/etMedName" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textCapWords" android:paddingVertical="14dp" android:textColor="@color/caremate_neutral" android:textSize="16sp" />
                </com.google.android.material.textfield.TextInputLayout>

                
                <com.google.android.material.textfield.TextInputLayout android:id="@+id/tilMedDosage" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:hint="@string/txt_fragment_med_form_183" app:boxBackgroundColor="@android:color/transparent" app:boxCornerRadiusBottomEnd="20dp" app:boxCornerRadiusBottomStart="20dp" app:boxCornerRadiusTopEnd="20dp" app:boxCornerRadiusTopStart="20dp" app:boxStrokeColor="@color/caremate_primary" app:boxStrokeWidth="1.5dp" app:startIconDrawable="@drawable/ic_info_circle" app:startIconTint="@color/caremate_primary">


<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAF8"
    tools:context=".ui.auth.AuthFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- TITLE -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CareMate"
            android:textColor="#191C1B"
            android:textSize="32sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Create your caregiver account"
            android:textColor="#404845"
            android:textSize="16sp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="32dp" />

        <!-- FORM CARD -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:padding="20dp">

            <!-- FULL NAME -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Full Name"
                android:textColor="#191C1B"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <EditText
                android:id="@+id/etName"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:backgroundTint="#386458"
                android:hint="Enter your full name"
                android:paddingHorizontal="16dp"
                android:textColor="#191C1B"
                android:textColorHint="#717975"
                android:layout_marginBottom="20dp" />

            <!-- EMAIL -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Email"
                android:textColor="#191C1B"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <EditText
                android:id="@+id/etEmail"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:backgroundTint="#386458"
                android:hint="Enter your email"
                android:inputType="textEmailAddress"
                android:paddingHorizontal="16dp"
                android:textColor="#191C1B"
                android:textColorHint="#717975"
                android:layout_marginBottom="20dp" />

            <!-- PASSWORD -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Password"
                android:textColor="#191C1B"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <EditText
                android:id="@+id/etPassword"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:backgroundTint="#386458"
                android:hint="Enter your password"
                android:inputType="textPassword"
                android:paddingHorizontal="16dp"
                android:textColor="#191C1B"
                android:textColorHint="#717975"
                android:layout_marginBottom="24dp" />

            <!-- ROLE -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Choose Role"
                android:textColor="#191C1B"
                android:textStyle="bold"
                android:layout_marginBottom="12dp" />

            <RadioGroup
                android:id="@+id/radioGroupRole"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="24dp">

                <RadioButton
                    android:id="@+id/rbCaregiver"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Caregiver"
                    android:textColor="#191C1B"
                    android:buttonTint="#386458" />

                <RadioButton
                    android:id="@+id/rbFamily"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Family"
                    android:textColor="#191C1B"
                    android:buttonTint="#386458"
                    android:layout_marginStart="20dp" />

            </RadioGroup>

            <!-- PAIRING CODE -->

            <TextView
                android:id="@+id/tvPairingLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pairing Code"
                android:textColor="#191C1B"
                android:textStyle="bold"
                android:layout_marginBottom="8dp"
                android:visibility="gone" />

            <EditText
                android:id="@+id/etPairingCode"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:backgroundTint="#386458"
                android:hint="Enter caregiver pairing code"
                android:paddingHorizontal="16dp"
                android:textColor="#191C1B"
                android:textColorHint="#717975"
                android:visibility="gone"
                android:layout_marginBottom="28dp" />

            <!-- REGISTER BUTTON -->

            <Button
                android:id="@+id/btnRegister"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="Register"
                android:textAllCaps="false"
                android:textColor="@android:color/white"
                android:textSize="16sp"
                android:textStyle="bold"
                android:backgroundTint="#386458" />

            <Button
                android:id="@+id/btnLogin"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="Login"
                android:textAllCaps="false"
                android:textColor="#386458"
                android:textStyle="bold"
                android:backgroundTint="#D8EADD"
                android:layout_marginTop="12dp" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>
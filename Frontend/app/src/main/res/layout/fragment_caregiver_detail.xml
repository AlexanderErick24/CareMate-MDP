<?xml version='1.0' encoding='utf-8'?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#F8FAF8">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">

        

        <TextView android:id="@+id/tvCaregiverName" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" android:text="@string/txt_fragment_caregiver_detail_89" android:textStyle="bold" android:textSize="22sp" android:textColor="#191C1B" />

        <TextView android:id="@+id/tvCaregiverJobTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" android:layout_marginTop="4dp" android:text="" android:textColor="#386458" android:textSize="14sp" android:textStyle="bold" />

        <TextView android:id="@+id/tvCaregiverAge" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" android:layout_marginTop="2dp" android:text="" android:textColor="#6B7280" android:textSize="14sp" />

        

        <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" app:cardCornerRadius="16dp" app:cardElevation="0dp" app:strokeColor="#E0E6E2" app:strokeWidth="1dp">

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/txt_dialog_reconnect_family_69" android:textStyle="bold" android:textColor="#191C1B" />

                <TextView android:id="@+id/tvCaregiverEmail" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textColor="#404845" />

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="@string/txt_fragment_caregiver_detail_90" android:textStyle="bold" android:textColor="#191C1B" />

                <TextView android:id="@+id/tvCaregiverPatientName" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textColor="#404845" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        

        <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" app:cardCornerRadius="16dp" app:cardElevation="0dp" app:strokeColor="#E0E6E2" app:strokeWidth="1dp">

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/txt_fragment_caregiver_detail_91" android:textStyle="bold" android:textSize="16sp" android:textColor="#191C1B" />

                <TextView android:id="@+id/tvCaregiverBio" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/txt_fragment_caregiver_detail_92" android:textColor="#404845" android:textSize="14sp" android:lineSpacingExtra="4dp" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        

        <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" app:cardCornerRadius="16dp" app:cardElevation="0dp" app:strokeColor="#E0E6E2" app:strokeWidth="1dp">

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/txt_fragment_caregiver_detail_93" android:textStyle="bold" android:textSize="16sp" android:textColor="#191C1B" />

                <TextView android:id="@+id/tvCaregiverExperience" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/txt_fragment_caregiver_detail_94" android:textColor="#404845" android:textSize="14sp" android:lineSpacingExtra="4dp" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        

        <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:layout_marginBottom="24dp" app:cardCornerRadius="16dp" app:cardElevation="0dp" app:strokeColor="#E0E6E2" app:strokeWidth="1dp">

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/txt_fragment_caregiver_detail_95" android:textStyle="bold" android:textSize="16sp" android:textColor="#191C1B" />

                <TextView android:id="@+id/tvCaregiverSkills" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/txt_fragment_caregiver_detail_96" android:textColor="#404845" android:textSize="14sp" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

</ScrollView>